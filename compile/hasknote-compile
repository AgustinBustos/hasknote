                             : {responsive: true, displaylogo: false, displayModeBar: "hover",
                                modeBarButtonsToRemove: ["lasso2d", "select2d", "autoScale2d"],
                                toImageButtonOptions: {format: "svg"}};
      await Plotly.newPlot(el, c.traces, layout, config);
    } else if (c.type === "vega") {
      if (typeof vegaEmbed === "undefined") { el.outerHTML = '<div class="chart-missing">vega-embed could not be loaded</div>'; return; }
      const spec = Object.assign({}, c.spec);
      const w = isPrint ? d.width : el.clientWidth, h = isPrint ? d.height : el.clientHeight;
      spec.width = w - 50; spec.height = h - 50;
      spec.autosize = {type: "fit", contains: "padding"};
      await vegaEmbed(el, spec, {renderer: "svg", actions: !isPrint,
        config: {font: "LM Roman 10", view: {stroke: "#222"}}});
    }
  }
  const ready = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
  ready.then(() => Promise.all(H.charts.map(c => draw(c).catch(e => console.error(e)))))
       .then(() => { window.HASKNOTE_DONE = true; document.body.dataset.done = "1"; });
  if (!isPrint) {
    // Printing the interactive page from a browser: freeze charts at the print width.
    window.addEventListener("beforeprint", () => H.charts.forEach(c => {
      const el = document.getElementById(c.id);
      if (c.type === "plotly" && el && el.data) Plotly.relayout(el, Object.assign({autosize: false}, dims(c, true)));
    }));
    window.addEventListener("afterprint", () => H.charts.forEach(c => {
      const el = document.getElementById(c.id);
      if (c.type === "plotly" && el && el.data) Plotly.relayout(el, {autosize: true, width: null, height: null});
    }));
  }
})();
