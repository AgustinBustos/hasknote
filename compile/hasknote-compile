from pygments.formatters.latex import LatexFormatter, escape_tex
from pygments.style import Style
from pygments.token import (Comment, Error, Keyword, Name, Number, Operator, Punctuation,
                            String, Token)


class HasknoteStyle(Style):
    """Same quiet, cool palette as the HTML stylesheet."""
    background_color = "#ffffff"
    styles = {
        Comment: "#8a919e",
        Keyword: "#2c4a7c",
        Operator.Word: "#2c4a7c",
        Keyword.Type: "#2f6668",
        Name.Class: "#2f6668",
        Name.Namespace: "#2f6668",
        String: "#7d3c5f",
        Number: "#5b3f8c",
        Operator: "#5b6472",
        Punctuation: "#5b6472",
        Error: "",
    }


TEX_SPECIALS = {"\\": r"\textbackslash{}", "{": r"\{", "}": r"\}", "$": r"\$", "&": r"\&",
                "#": r"\#", "^": r"\textasciicircum{}", "_": r"\_", "%": r"\%", "~": r"\textasciitilde{}"}


def tex_escape(s: str) -> str:
    return "".join(TEX_SPECIALS.get(ch, ch) for ch in s)


def tex_inline(s: str) -> str:
    """Prose comments: `code`, **bold**, *italic*, $math$ (math passes through)."""
    out = []
    for p in re.split(r"(`[^`]+`|\$\$[^$]+\$\$|\$[^$\n]+\$)", s):
        if p.startswith("`") and p.endswith("`") and len(p) > 1:
            out.append(r"\texttt{" + tex_escape(p[1:-1]) + "}")
        elif p.startswith("$$") and p.endswith("$$") and len(p) > 4:
            out.append(r"\[" + p[2:-2] + r"\]")
        elif p.startswith("$") and p.endswith("$") and len(p) > 2:
            out.append(p)
        else:
            e = tex_escape(p)
            e = re.sub(r"\*\*(.+?)\*\*", r"\\textbf{\1}", e)
            e = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"\\emph{\1}", e)
            out.append(e)
    return "".join(out)


def fmt_num_tex(x: float, sig: int = 4) -> str:
    if math.isnan(x):
        return r"\mathrm{NaN}"
    if math.isinf(x):
        return r"\infty" if x > 0 else r"-\infty"
    if abs(x) < 1e-12:
        return "0"
    ax = abs(x)
    if 1e-4 <= ax < 1e6:
        s = f"{x:.{sig}g}"
        if "e" in s:
            s = f"{x:.0f}"
        return s
    mant, exp = f"{x:.{sig - 1}e}".split("e")
    mant = mant.rstrip("0").rstrip(".")
    return rf"{mant}\times 10^{{{int(exp)}}}"


# ---- Markdown -> LaTeX -----------------------------------------------------

def markdown_to_tex(text: str) -> str:
    render_markdown("")  # initialise the shared parser
    tokens = _MD.parse(text)
    out: list[str] = []
    lists: list[str] = []
    table: dict | None = None

    def inline(children) -> str:
        buf = []
        for t in children or []:
            ty = t.type
            if ty == "text":
                buf.append(tex_escape(t.content))
            elif ty == "code_inline":
                buf.append(r"\texttt{" + tex_escape(t.content) + "}")
            elif ty == "math_inline":
                buf.append("$" + t.content + "$")
            elif ty == "math_inline_double":
                buf.append(r"\[" + t.content + r"\]")
            elif ty == "strong_open":
                buf.append(r"\textbf{")
            elif ty == "em_open":
                buf.append(r"\emph{")
            elif ty == "s_open":
                buf.append("{")
            elif ty in ("strong_close", "em_close", "s_close"):
                buf.append("}")
            elif ty == "link_open":
                buf.append(r"\href{" + tex_escape(t.attrs.get("href", "")).replace(r"\#", r"\#") + "}{")
            elif ty == "link_close":
                buf.append("}")
            elif ty == "softbreak":
                buf.append("\n")
            elif ty == "hardbreak":
                buf.append(r"\\" + "\n")
            elif ty == "image":
                buf.append(r"\emph{[image: " + tex_escape(t.content or t.attrs.get("src", "")) + "]}")
        return "".join(buf)

    sections = {1: "section", 2: "subsection", 3: "subsubsection"}
    i = 0
    while i < len(tokens):
        t = tokens[i]
        ty = t.type
        if ty == "heading_open":
            lvl = int(t.tag[1])
            cmd = sections.get(lvl, "paragraph")
            out.append(f"\\{cmd}{{{inline(tokens[i + 1].children)}}}\n")
            i += 3
            continue
        if ty == "paragraph_open":
            body = inline(tokens[i + 1].children)
            if table is None:
                out.append(body + ("\n" if t.hidden else "\n\n"))
            i += 3
            continue
        if ty == "bullet_list_open":
            lists.append("itemize")
            out.append("\\begin{itemize}\n")
        elif ty == "ordered_list_open":
            lists.append("enumerate")
            out.append("\\begin{enumerate}\n")
        elif ty in ("bullet_list_close", "ordered_list_close"):
            out.append(f"\\end{{{lists.pop()}}}\n")
        elif ty == "list_item_open":
            out.append("\\item ")
        elif ty == "blockquote_open":
            out.append("\\begin{quote}\\itshape\n")
        elif ty == "blockquote_close":
            out.append("\\end{quote}\n")
        elif ty in ("fence", "code_block"):
            lang = (t.info or "").strip().lower()
            out.append(verbatim_block(t.content.rstrip("\n").split("\n"),
                                      lexer=HaskellLexer if lang in ("haskell", "hs", "ghci") else None))
        elif ty == "math_block" or ty == "math_block_eqno":
            out.append("\\[\n" + t.content.strip() + "\n\\]\n")
        elif ty == "hr":
            out.append("\\medskip\\noindent\\textcolor{hnrule}{\\rule{\\linewidth}{0.4pt}}\\medskip\n")
        elif ty == "table_open":
            table = {"rows": [], "align": []}
        elif ty == "tr_open":
            table["rows"].append([])
        elif ty in ("th_open", "td_open"):
            style = t.attrs.get("style", "") if t.attrs else ""
            if len(table["rows"]) == 1:
                table["align"].append("r" if "right" in style else "c" if "center" in style else "l")
            table["rows"][-1].append(inline(tokens[i + 1].children))
            i += 3
            continue
        elif ty == "thead_close":
            table["head"] = len(table["rows"])
        elif ty == "table_close":
            rows, head = table["rows"], table.get("head", 1)
            lines = ["\\begin{center}", "\\begin{tabular}{" + "".join(table["align"]) + "}", "\\toprule"]
            for k, r in enumerate(rows):
                lines.append(" & ".join(r) + r" \\")
                if k == head - 1:
                    lines.append("\\midrule")
            lines += ["\\bottomrule", "\\end{tabular}", "\\end{center}"]
            out.append("\n".join(lines) + "\n")
            table = None
        elif ty == "html_block":
            pass
        i += 1
    return "".join(out).strip() + "\n"


# ---- code blocks ------------------------------------------------------------

_TEX_FMT = None


def tex_formatter() -> LatexFormatter:
    global _TEX_FMT
    if _TEX_FMT is None:
        _TEX_FMT = LatexFormatter(style=HasknoteStyle, commandprefix="PY")
    return _TEX_FMT


def _tex_token(ttype, value: str) -> str:
    fmt = tex_formatter()
    v = escape_tex(value, "PY")
    if not v.isascii():
        v = "".join(ch if ord(ch) < 128 or ch in "áéíóúñÁÉÍÓÚÑüÜ" else CODE_UNICODE_TEX.get(ch, "?") for ch in v)
    styles = []
    while ttype is not Token:
        name = fmt.ttype2name.get(ttype)
        if name:
            styles.append(name)
        ttype = ttype.parent
    return f"\\PY{{{'+'.join(reversed(styles))}}}{{{v}}}" if styles else v


def verbatim_block(lines: list[str], lexer=HaskellLexer, label: str = "", width: int = 78) -> str:
    """Pygments-highlighted fancyvrb Verbatim; long lines are wrapped in Python with
    a hanging indent (fancyvrb cannot wrap)."""
    src = "\n".join(lines)
    toks = list((lexer(stripnl=False) if lexer else _PlainLexer()).get_tokens(src))
    logical: list[list[tuple]] = [[]]
    for ttype, value in toks:
        for k, piece in enumerate(value.split("\n")):
            if k:
                logical.append([])
            if piece:
                logical[-1].append((ttype, piece))
    while logical and not logical[-1]:
        logical.pop()
    visual: list[list[tuple]] = []
    for line in logical:
        text = "".join(p for _, p in line)
        if len(text) <= width:
            visual.append(line)
            continue
        hang = min(len(text) - len(text.lstrip(" ")) + 4, width // 2)
        cur, n = [], 0
        limit = width
        for ttype, piece in line:
            while piece:
                room = limit - n
                if len(piece) > room and n > hang and " " not in piece.strip() and len(piece) <= 24:
                    visual.append(cur)  # move a whole short token to the next line
                    cur, n = [(Token.Text, " " * hang)], hang
                    continue
                if len(piece) <= room:
                    cur.append((ttype, piece))
                    n += len(piece)
                    piece = ""
                else:
                    cut = piece.rfind(" ", 0, room + 1)
                    cut = cut if cut > 0 and room - cut < 20 else room
                    cur.append((ttype, piece[:cut]))
                    visual.append(cur)
                    piece = piece[cut:].lstrip(" ") if cut != room else piece[cut:]
                    cur, n = [(Token.Text, " " * hang)], hang
        visual.append(cur)
    body = "\n".join("".join(_tex_token(t, p) for t, p in vl) for vl in visual)
    lab = f"\\hnlabel{{{label}}}" if label else ""
    return f"\\begin{{hncode}}\n{lab}{body}\n\\end{{hncode}}\n"


class _PlainLexer:
    def get_tokens(self, src):
        yield Token.Text, src


# ---- outputs --------------------------------------------------------------

def value_tex(v, top: bool = False) -> str:
    if isinstance(v, Num):
        return fmt_num_tex(v.value, 6 if top else 4)
    if isinstance(v, Str):
        return r"\text{\itshape ``" + tex_escape(v.text) + "''}"
    if isinstance(v, Mat):
        rows = [v.data[i * v.cols:(i + 1) * v.cols] for i in range(v.rows)]
        body = r" \\ ".join(" & ".join(fmt_num_tex(x.value) for x in r) for r in rows)
        return r"\begin{bmatrix} " + body + r" \end{bmatrix}"
    if isinstance(v, Lst):
        if v.items and all(isinstance(x, Num) for x in v.items):
            chunks = [v.items[k:k + 9] for k in range(0, len(v.items), 9)]
            body = r" \\ ".join(r" & ".join(fmt_num_tex(x.value) for x in c) for c in chunks)
            return r"\left[\begin{array}{" + "r" * max(len(c) for c in chunks) + "} " + body + r" \end{array}\right]"
        return r"\left[" + r",\; ".join(value_tex(x) for x in v.items) + r"\right]"
    if isinstance(v, Tup):
        return r"\left(" + r",\;\; ".join(value_tex(x) for x in v.items) + r"\right)"
    return r"\text{" + tex_escape(str(v)) + "}"


class TexRenderer:
    def __init__(self, args, nb_path: Path, figdir: Path):
        self.args = args
        self.nb_path = nb_path
        self.nb_dir = nb_path.parent
        self.figdir = figdir
        self.fig_no = 0
        self.tab_no = 0
        self.charts: list[dict] = []  # charts to export: {"id", "file", payload...}
        self.missing: list[str] = []

    def table_tex(self, vals: list) -> str:
        self.tab_no += 1
        groups = vals[0].items[1:]
        widths = [len(g.items) if isinstance(g, Tup) else 1 for g in groups]
        nested = any(w > 1 for w in widths)
        spec = "l" + "".join("r" * w for w in widths)
        head1 = [""] + [f"\\multicolumn{{{w}}}{{c}}{{({k})}}" if w > 1 else f"({k})" for k, w in enumerate(widths, 1)]
        # not a float: the table is a cell output and stays right below its code
        lines = [r"\par\smallskip\begin{center}\begin{minipage}{\linewidth}\centering\small",
                 f"\\captionof{{table}}{{}}\\label{{tab:{self.tab_no}}}",
                 f"\\begin{{tabular}}{{{spec}}}", r"\toprule", " & ".join(head1) + r" \\"]
        if nested:
            col, rules = 2, []
            for w in widths:
                if w > 1:
                    rules.append(f"\\cmidrule(lr){{{col}-{col + w - 1}}}")
                col += w
            lines.append("".join(rules))
            sub = [""] + [f"\\textit{{{'abcdefgh'[k]}}}" if w > 1 else "" for w in widths for k in range(w)]
            lines.append(" & ".join(sub) + r" \\")
        lines.append(r"\midrule")
        for v in vals:
            cells = [tex_escape(v.items[0].text)]
            for g in v.items[1:]:
                for x in (g.items if isinstance(g, Tup) else [g]):
                    cells.append(fmt_fixed(x.value).replace("−", "$-$"))
            lines.append(" & ".join(cells) + r" \\")
        lines += [r"\bottomrule", r"\end{tabular}", r"\end{minipage}\end{center}"]
        return "\n".join(lines) + "\n"

    def output_tex(self, text: str, n: int) -> str:
        vals, rest = ValueParser(text).top()
        if not vals:
            return f"\\begin{{hnraw}}\n{verbatim_block(text.split(chr(10)), lexer=None, label=f'out [{n}]')}\\end{{hnraw}}\n"
        parts, i = [], 0
        while i < len(vals):
            j = i
            while j < len(vals) and isinstance(vals[j], Tup) and vals[j].items and isinstance(vals[j].items[0], Str):
                j += 1
            if j - i >= 2 and table_rows(vals[i:j]):
                parts.append(("table", vals[i:j]))
                i = j
            else:
                parts.append(("val", vals[i]))
                i += 1
        out = []
        pending: list[str] = []

        def flush():
            if pending:
                body = r" \\[2pt] ".join(f"\\displaystyle {p}" for p in pending)
                out.append(f"\\begin{{hnout}}{{{n}}}\n$\\begin{{array}}[t]{{@{{}}l@{{}}}} {body} \\end{{array}}$\n\\end{{hnout}}\n")
                pending.clear()

        for kind, p in parts:
            if kind == "table":
                flush()
                out.append(self.table_tex(p))
            else:
                pending.append(value_tex(p, top=True))
        flush()
        if rest:
            out.append(f"\\begin{{hnraw}}\n{verbatim_block(rest.split(chr(10)), lexer=None)}\\end{{hnraw}}\n")
        return "".join(out)

    def chart_file(self, spec: dict, panel: bool) -> str | None:
        if spec["type"] == "missing":
            self.missing.append(spec["path"])
            return None
        if spec["type"] not in ("plotly", "vega"):
            return None
        k = len(self.charts) + 1
        fname = f"chart-{k:02d}.pdf"
        payload = {"id": f"c{k}", "file": fname, "panel": panel, "type": spec["type"]}
        if spec["type"] == "plotly":
            payload.update(prepare_plotly(spec, panel, self.args.keep_plot_style))
        else:
            vs = copy.deepcopy(spec["spec"])
            vs.pop("title", None)
            payload["spec"] = vs
        self.charts.append(payload)
        return f"{self.figdir.name}/{fname}"

    def graphic(self, path: str | None, width: str) -> str:
        if path is None:
            return f"\\hnmissing{{{width}}}"
        return f"\\includegraphics[width={width}]{{{path}}}"

    def figure_tex(self, specs: list[dict], fallback: str) -> str:
        self.fig_no += 1
        titles = [chart_title(s) for s in specs]
        if len(specs) == 1:
            cap = titles[0] or fallback or series_label(specs[0])
            sub = series_label(specs[0]) if (titles[0] or fallback) else ""
            capt = tex_inline(_cap(cap)) + (f" {{\\color{{hnink2}}{tex_escape(_cap(sub))}}}" if sub and sub != cap else "")
            g = self.graphic(self.chart_file(specs[0], False), "0.86\\linewidth")
            return (f"\\begin{{figure}}[htbp]\n\\centering\n{g}\n\\caption{{{capt}}}\\label{{fig:{self.fig_no}}}\n\\end{{figure}}\n")
        common = titles[0] if titles[0] and len(set(titles)) == 1 else ""
        cap = common or fallback
        subs = []
        for k, s in enumerate(specs):
            sub = (titles[k] if titles[k] and not common else "") or series_label(s)
            g = self.graphic(self.chart_file(s, True), "\\linewidth")
            sep = "\\hfill\n" if k % 2 == 0 else "\n\\par\\medskip\n"
            subs.append(f"\\begin{{subfigure}}[t]{{0.485\\linewidth}}\n\\centering\n{g}\n\\caption{{{tex_escape(sub)}}}\n\\end{{subfigure}}{sep}")
        return (f"\\begin{{figure}}[htbp]\n\\centering\n{''.join(subs)}"
                f"\\caption{{{tex_inline(_cap(cap)) if cap else ''}}}\\label{{fig:{self.fig_no}}}\n\\end{{figure}}\n")

    def body(self, cells: list[Cell]) -> tuple[str, int]:
        out = []
        n_cell = 0
        n_sections = 0
        cmds = {1: "section", 2: "subsection", 3: "subsubsection"}
        for cell in cells:
            if cell.kind == "md":
                text = "\n".join(cell.md).strip()
                if text:
                    tex = markdown_to_tex(text)
                    n_sections += len(re.findall(r"\\(?:sub)*section\{", tex))
                    out.append(f"% --- markdown cell\n{tex}\n")
                continue
            if cell.level and cell.title:
                out.append(f"\\{cmds.get(min(cell.level, 3))}{{{tex_inline(cell.title)}}}\n\n")
                n_sections += 1
            prose, code = ([], tidy_lines(cell.code)) if self.args.no_prose else split_prose(cell.code)
            segs = split_output(cell.output)
            if not (prose or code or segs):
                continue
            n_cell += 1
            if is_setup(code) and not prose and not any(isinstance(s, Chart) for s in segs):
                count = len([l for l in code if l.strip()])
                mods = [m for l in code for m in re.findall(r"^\s*import\s+(?:qualified\s+)?([\w.]+)", l)]
                listing = ", ".join(tex_escape(m) for m in mods[:6]) + (", \\ldots" if len(mods) > 6 else "")
                out.append(f"% --- cell {n_cell}: setup (omitted)\n\\hnsetup{{{count} lines of GHCi options and imports"
                           f"{': ' + listing if listing else ''}}}\n\n")
                continue
            out.append(f"% --- cell {n_cell}\n")
            if prose:
                out.append(self.prose_tex(prose))
            if code and not self.args.hide_code:
                out.append(verbatim_block(code, label=f"in [{n_cell}]"))
            first_prose = next((p for p in prose if p), "")
            group: list[dict] = []

            def flush_group():
                if group:
                    size = 1 if self.args.no_panels else 6
                    for k in range(0, len(group), size):
                        out.append(self.figure_tex(group[k:k + size], first_prose))
                    group.clear()

            for seg in segs:
                if isinstance(seg, Chart):
                    group.append(load_chart(seg, self.nb_dir))
                else:
                    flush_group()
                    out.append(self.output_tex(seg, n_cell))
            flush_group()
            out.append("\n")
        return "".join(out), n_sections

    def prose_tex(self, lines: list[str]) -> str:
        paras, cur = [], []
        for ln in lines + [""]:
            if ln:
                cur.append(ln)
            elif cur:
                paras.append(cur)
                cur = []
        out = []

        def label(t):
            return len(t) <= 48 and not re.search(r"[.!?;:,]$", t)

        for p in paras:
            if label(p[0]) and (len(p) == 1 or len(p[1]) > len(p[0])):
                out.append(f"\\hnrunin{{{tex_inline(_cap(p[0], period=False))}}}\n")
                p = p[1:]
            if p and len(p) <= 4 and all(label(x) for x in p):
                out.append("\\hnrunin{" + " \\textperiodcentered\\ ".join(tex_inline(_cap(x, period=False)) for x in p) + "}\n")
            elif p:
                out.append(tex_inline(_cap(" ".join(p), period=False)) + "\n\n")
        return "".join(out)

    def document(self, cells: list[Cell]) -> str:
        a = self.args
        body, n_sections = self.body(cells)
        styledefs = tex_formatter().get_style_defs()
        title = tex_inline(a.title)
        short = tex_inline(short_title(a.short_title or a.title))
        meta = []
        if a.subtitle:
            meta.append(f"{{\\large\\itshape\\color{{hnink2}} {tex_inline(a.subtitle)}\\par}}\\vspace{{3mm}}")
        byline = []
        if a.author:
            byline.append(f"\\textsc{{{tex_escape(a.author)}}}")
        if a.date:
            byline.append(f"\\textit{{{tex_escape(a.date)}}}")
        if byline:
            meta.append("{\\color{hnink2} " + " \\enspace{\\color{hnmuted}\\textperiodcentered}\\enspace ".join(byline) + "\\par}")
        toc = "\\tableofcontents\n\\vspace{4mm}\n" if n_sections >= 2 else ""
        mono = ("% code font: FiraCode Nerd Font, converted for pdfTeX by hasknote-compile into ~/texmf\n"
                "% (falls back to Latin Modern Mono when that conversion is not available)\n"
                "\\IfFileExists{T1hnfira.fd}{\\pdfmapfile{+hasknote-fira.map}\\renewcommand{\\ttdefault}{hnfira}}{}"
                if ensure_tex_code_font() else "% code font: Latin Modern Mono")
        return TEX_TEMPLATE.replace("%%STYLEDEFS%%", styledefs).replace("%%MONO%%", mono) \
            .replace("%%SHORT%%", short).replace("%%TITLE%%", title) \
            .replace("%%FILE%%", tex_escape(self.nb_path.name)).replace("%%META%%", "\n".join(meta)) \
            .replace("%%TOC%%", toc).replace("%%BODY%%", body) \
            .replace("%%PDFTITLE%%", tex_escape(a.title)).replace("%%PDFAUTHOR%%", tex_escape(a.author or ""))


def ensure_tex_code_font() -> bool:
    """Make the code Nerd Font usable from pdfLaTeX: otftotfm writes TFM/VF/encoding files
    and a map line (the TrueType file is embedded as is) into the user's TEXMFHOME, plus an
    NFSS font definition T1hnfira.fd. Runs once; later builds and hand recompiles reuse it."""
    try:
        home = Path(subprocess.run(["kpsewhich", "-var-value", "TEXMFHOME"], capture_output=True,
                                   text=True, timeout=20).stdout.strip() or Path.home() / "texmf")
    except (OSError, subprocess.SubprocessError):
        return False
    fd = home / "tex/latex/hasknote/T1hnfira.fd"
    if fd.exists():
        return True
    if not shutil.which("otftotfm"):
        return False
    faces = {"r": _code_font_file(CODE_FACES[0][3]), "sb": _code_font_file(CODE_FACES[1][3])}
    if not faces["r"]:
        return False
    dirs = {k: home / f"fonts/{k}/hasknote" for k in ("tfm", "vf", "enc", "truetype", "map")}
    dirs["map"] = home / "fonts/map/pdftex/hasknote"
    for d in dirs.values():
        d.mkdir(parents=True, exist_ok=True)
    maplines = []
    for key, f in faces.items():
        if not f:
            continue
        shutil.copyfile(f, dirs["truetype"] / f.name)
        r = subprocess.run(["otftotfm", "-e", "ec", "-f", "kern", "--no-updmap",
                            f"--tfm-directory={dirs['tfm']}", f"--vf-directory={dirs['vf']}",
                            f"--encoding-directory={dirs['enc']}", f"--pl-directory={dirs['tfm']}",
                            f"--truetype-directory={dirs['truetype']}", f"--type42-directory={dirs['truetype']}",
                            str(f), f"hnfira-{key}"], capture_output=True, text=True, timeout=120)
        maplines += [l for l in r.stdout.splitlines() if l.startswith("hnfira-")]
    if not maplines:
        return False
    (dirs["map"] / "hasknote-fira.map").write_text("\n".join(maplines) + "\n", encoding="utf-8")
    fd.parent.mkdir(parents=True, exist_ok=True)
    bold = "hnfira-sb" if faces["sb"] else "hnfira-r"
    fd.write_text(f"""% FiraCode Nerd Font for pdfLaTeX (generated by hasknote-compile)
\\ProvidesFile{{T1hnfira.fd}}
\\DeclareFontFamily{{T1}}{{hnfira}}{{\\hyphenchar\\font=-1}}
\\DeclareFontShape{{T1}}{{hnfira}}{{m}}{{n}}{{<-> s*[0.86] hnfira-r}}{{}}
\\DeclareFontShape{{T1}}{{hnfira}}{{b}}{{n}}{{<-> s*[0.86] {bold}}}{{}}
\\DeclareFontShape{{T1}}{{hnfira}}{{bx}}{{n}}{{<->ssub * hnfira/b/n}}{{}}
\\DeclareFontShape{{T1}}{{hnfira}}{{m}}{{it}}{{<->ssub * hnfira/m/n}}{{}}
\\DeclareFontShape{{T1}}{{hnfira}}{{m}}{{sl}}{{<->ssub * hnfira/m/n}}{{}}
\\DeclareFontShape{{T1}}{{hnfira}}{{b}}{{it}}{{<->ssub * hnfira/b/n}}{{}}
\\DeclareFontShape{{T1}}{{hnfira}}{{m}}{{sc}}{{<->ssub * hnfira/m/n}}{{}}
""", encoding="utf-8")
    return True


