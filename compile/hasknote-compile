  <cachedir>{CACHE / 'fc-cache'}</cachedir>
</fontconfig>
""", encoding="utf-8")
    return conf


def export_charts(charts: list[dict], figdir: Path, budget_ms: int) -> None:
    """Render each chart once in headless Chromium, take Plotly's SVG export and turn
    it into a vector PDF with rsvg-convert."""
    if not charts:
        return
    chrome = find_chromium()
    if not chrome or not shutil.which("rsvg-convert"):
        sys.exit("hasknote-compile: the PDF needs chromium and rsvg-convert on PATH")
    figdir.mkdir(parents=True, exist_ok=True)
    plotly = cached_asset(PLOTLY_CDN, f"plotly-{PLOTLY_VERSION}.min.js")
    scripts = f'<script src="{plotly.as_uri()}"></script>' if plotly else f'<script src="{PLOTLY_CDN}"></script>'
    if any(c["type"] == "vega" for c in charts):
        scripts += "".join(f'<script src="{u}"></script>' for u in VEGA_CDN)
    data = json.dumps({"width": PRINT_TEXT_WIDTH_PX - 20, "charts": charts}, separators=(",", ":")).replace("</", "<\\/")
    lm10 = next((f for fam, w, st, f in font_faces() if fam == "LM Roman 10" and w == 400 and st == "normal"), None)
    alias = f"@font-face{{font-family:LMRoman10;src:url({lm10.as_uri()});}}" if lm10 else ""
    page = (f"<!doctype html><html><head><meta charset='utf-8'><style>{print_font_css()}{alias}</style>{scripts}</head>"
            f"<body><script>window.HASKNOTE_EXPORT = {data};</script>"
            f"<script>document.fonts.ready.then(() => {{ {EXPORT_JS} }});</script></body></html>")
    env = dict(os.environ, FONTCONFIG_FILE=str(_fontconfig_file()))
    with tempfile.TemporaryDirectory(prefix="hasknote-fig-") as tmp:
        src = Path(tmp) / "export.html"
        src.write_text(page, encoding="utf-8")
        cmd = [chrome, "--headless=new", "--disable-gpu", "--no-first-run", "--no-default-browser-check",
               "--allow-file-access-from-files", f"--user-data-dir={tmp}/profile",
               f"--virtual-time-budget={budget_ms}", "--dump-dom", src.as_uri()]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
        dom = r.stdout
        if os.environ.get("HASKNOTE_DEBUG"):
            shutil.copyfile(src, figdir / "_export.html")
            (figdir / "_export.dom.html").write_text(dom + "\n<!-- stderr\n" + r.stderr + "\n-->", encoding="utf-8")
        for c in charts:
            m = re.search(rf'<textarea id="svg-{c["id"]}">(.*?)</textarea>', dom, re.S)
            try:
                svg = base64.b64decode(m.group(1).strip()).decode("utf-8") if m else ""
            except ValueError:
                svg = ""
            out = figdir / c["file"]
            if not svg.startswith("<svg"):
                print(f"hasknote-compile: chart {c['id']} could not be exported: {svg[:120]}", file=sys.stderr)
                continue
            svg_path = Path(tmp) / (c["id"] + ".svg")
            svg_path.write_text(svg, encoding="utf-8")
            rr = subprocess.run(["rsvg-convert", "-f", "pdf", "-o", str(out), str(svg_path)],
                                capture_output=True, text=True, env=env, timeout=60)
            if rr.returncode != 0:
                print(f"hasknote-compile: rsvg-convert failed for {c['file']}: {rr.stderr.strip()}", file=sys.stderr)


def compile_tex(tex_path: Path, pdf_path: Path) -> None:
    """Run pdflatex twice in a temporary build directory and copy the PDF out.
    (pdfLaTeX, not LuaLaTeX: this TeX Live has no luaotfload, so fontspec cannot load
    fonts; Latin Modern comes from lmodern and the code font is converted with otftotfm.)"""
    engine = shutil.which("pdflatex")
    if not engine:
        sys.exit("hasknote-compile: pdflatex not found (use --tex-only to just write the .tex)")
    with tempfile.TemporaryDirectory(prefix="hasknote-tex-") as tmp:
        build = Path(tmp)
        for run in (1, 2):
            r = subprocess.run([engine, "-interaction=nonstopmode", "-halt-on-error", "-file-line-error",
                                f"-output-directory={build}", tex_path.name],
                               cwd=tex_path.parent, capture_output=True, text=True, timeout=600)
            if r.returncode != 0:
                log = (build / (tex_path.stem + ".log"))
                text = log.read_text(errors="replace") if log.exists() else r.stdout
                lines = text.splitlines()
                errs = [k for k, l in enumerate(lines) if l.startswith("!") or re.match(r"^\S+\.tex:\d+:", l)]
                shown = []
                for k in errs[:5]:
                    shown += lines[max(0, k - 2):k + 6]
                sys.stderr.write("\n".join(shown or lines[-40:]) + "\n")
                sys.exit(f"hasknote-compile: pdflatex failed (run {run}); the .tex is kept at {tex_path}")
        shutil.copyfile(build / (tex_path.stem + ".pdf"), pdf_path)


