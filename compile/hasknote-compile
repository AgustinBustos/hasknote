  }));
  // Charts: 16:10 single figures, 3:2 panels; print sizes are fixed (A4 text block).
  function dims(c, pr = isPrint) {
    if (!pr) return {};
    const gap = 16, w = c.panel ? Math.floor((H.printWidth - gap) / 2) : Math.round(H.printWidth * 0.86);
    return {width: w, height: Math.round(w / (c.panel ? 1.5 : 1.6))};
  }
  async function draw(c) {
