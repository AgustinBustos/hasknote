# --------------------------------------------------------------------------
# Notebook parsing


@dataclass
class Chart:
    path: str
    kind: str  # "html" | "plot"


@dataclass
class Cell:
    kind: str = "code"  # "code" | "md"
    md: list[str] = field(default_factory=list)
    level: int = 0  # 0 = no heading; 1 = HS#, 2 = HS##, ...
    title: str = ""
    code: list[str] = field(default_factory=list)
    output: list[str] = field(default_factory=list)


def parse_notebook(text: str) -> list[Cell]:
    cells: list[Cell] = []
    cur: Cell | None = None
    in_output = False
    in_md = False      # inside an MS cell
    skipping = False   # between MF and the next HS/MS (editor preview lines)
    for line in text.splitlines():
        if MS_RE.match(line):
            cur = Cell(kind="md")
            cells.append(cur)
            in_md, skipping, in_output = True, False, False
            continue
        if in_md and MF_RE.match(line):
            in_md, skipping = False, True
            continue
        if in_md:
            cur.md.append(line.rstrip())
            continue
        m = HS_RE.match(line)
        if m:
            skipping = False
            title = m.group(2).strip("# ").strip()
            cur = Cell(level=len(m.group(1)) if title else 0, title=title)
            cells.append(cur)
            in_output = False
            continue
        if skipping:
            continue
        if HF_RE.match(line):
            if cur is None:
                cur = Cell()
                cells.append(cur)
            in_output = True
            continue
        if cur is None:  # preamble before the first HS
            if not line.strip():
                continue
            cur = Cell()
            cells.append(cur)
        (cur.output if in_output else cur.code).append(line.rstrip())
    return cells


def tidy_lines(lines: list[str]) -> list[str]:
    """Strip leading/trailing blank lines and collapse runs of blanks to one."""
    out: list[str] = []
    for ln in lines:
        if not ln.strip():
            if out and out[-1] != "":
                out.append("")
        else:
            out.append(ln)
    while out and out[-1] == "":
        out.pop()
    return out


def take_directives(cells: list[Cell]) -> dict:
    """`-- title: ...`, `-- subtitle:`, `-- author:`, `-- date:` comment lines at the
    top of the first non-empty cell set the title block (and are removed)."""
    meta: dict = {}
    for cell in cells:
        if not any(l.strip() for l in cell.code):
            continue
        keep = []
        header = True
        for ln in cell.code:
            m = DIRECTIVE_RE.match(ln.strip()) if header else None
            if m:
                meta[m.group(1).lower()] = m.group(2)
                continue
            if ln.strip() and not ln.strip().startswith("--"):
                header = False
            keep.append(ln)
        cell.code = keep
        break
    return meta


def split_prose(code: list[str]) -> tuple[list[str], list[str]]:
    """Leading `--` comment lines that read like prose become text above the code.
    Stops at the first non-comment line or at a comment that looks like code."""
    prose: list[str] = []
    i = 0
    while i < len(code):
        ln = code[i].strip()
        if not ln:
            if prose and prose[-1] != "":
                prose.append("")
            i += 1
            continue
        m = re.match(r"^--(?![-!#$%&*+./<=>?@\\^|~:])\s?(.*)$", ln)
        plain = re.sub(r"\$[^$]+\$|`[^`]+`", "", m.group(1)) if m else ""
        if not m or CODEY_RE.search(plain) or m.group(1).lstrip().startswith("|"):
            break
        prose.append(m.group(1).strip())
        i += 1
    return tidy_lines(prose), tidy_lines(code[i:])


def is_setup(code: list[str]) -> bool:
    lines = [l for l in code if l.strip() and not l.strip().startswith("--")]
    return bool(lines) and all(SETUP_RE.match(l) for l in lines)


def _depth(s: str) -> int:
    d = 0
    in_str = False
    prev = ""
    for ch in s:
        if in_str:
            if ch == '"' and prev != "\\":
                in_str = False
        elif ch == '"':
            in_str = True
        elif ch in "([{":
            d += 1
        elif ch in ")]}":
            d -= 1
        prev = ch
    return d


def rejoin_wrapped(lines: list[str], min_len: int = 70) -> list[str]:
    """Undo hard wraps the terminal put into captured output: join a line with the
    previous one when the previous is long and either brackets are still open or
    the break falls in the middle of a token. Deliberate continuation lines (like
    hmatrix rows) start with whitespace and are left alone."""
    out: list[str] = []
    depth = 0
    for ln in lines:
        if out and ln and not ln[0].isspace() and len(out[-1]) >= min_len:
            prev = out[-1]
            mid_token = prev[-1:].isalnum() and ln[:1].isalnum()
            if depth > 0 or mid_token:
                out[-1] = prev + ln
                depth += _depth(ln)
                continue
        out.append(ln)
        depth += _depth(ln)
        if depth < 0:
            depth = 0
    return out


def split_output(lines: list[str]) -> list[str | Chart]:
    """Output lines -> sequence of text blocks and Chart markers (in order)."""
    segs: list[str | Chart] = []
    buf: list[str] = []

    def flush():
        t = "\n".join(tidy_lines(rejoin_wrapped(buf)))
        if t.strip():
            segs.append(t)
        buf.clear()

    i = 0
    while i < len(lines):
        ln = lines[i].strip()
        if NOISE_RE.match(lines[i]):
            i += 1
            continue
        if MARKER_START_RE.match(ln):
            m = MARKER_RE.match(ln)
            used = 1
            if not m and i + 1 < len(lines):  # marker wrapped by the terminal
                m = MARKER_RE.match(ln + lines[i + 1].strip())
                used = 2
            if m:
                flush()
                segs.append(Chart(path=m.group(2), kind=m.group(1)))
                i += used
                continue
        buf.append(lines[i])
        i += 1
    flush()
    return segs


# --------------------------------------------------------------------------
# GHCi output values: a small parser for `show` output of numbers, strings,
# tuples, lists and hmatrix matrices ("(3><3)\n [ a, b, c\n , ... ]").

TOKEN_RE = re.compile(r"""
    (?P<ws>\s+)
  | (?P<dim>\(\s*\d+\s*><\s*\d+\s*\))
  | (?P<num>-?(?:\d+\.?\d*(?:[eE][-+]?\d+)?|Infinity|NaN))
  | (?P<str>"(?:\\.|[^"\\])*")
  | (?P<punct>[()\[\],])
  | (?P<other>.)
""", re.X | re.S)


class ParseError(Exception):
    pass


@dataclass
class Num:
    raw: str

    @property
    def value(self) -> float:
        return float(self.raw.replace("Infinity", "inf").replace("NaN", "nan"))


@dataclass
class Str:
    text: str


@dataclass
class Tup:
    items: list


@dataclass
class Lst:
    items: list


@dataclass
class Mat:
    rows: int
    cols: int
    data: list  # list[Num], row-major


def tokenize(s: str) -> list[tuple[str, str, int]]:
    toks = []
    for m in TOKEN_RE.finditer(s):
        kind = m.lastgroup
        if kind == "ws":
            continue
        toks.append((kind, m.group(), m.start()))
    return toks


class ValueParser:
    def __init__(self, text: str):
        self.text = text
        self.toks = tokenize(text)
        self.i = 0

    def peek(self):
        return self.toks[self.i] if self.i < len(self.toks) else (None, None, len(self.text))

    def next(self):
        t = self.peek()
        self.i += 1
        return t

    def expect(self, v):
        t = self.next()
        if t[1] != v:
            raise ParseError(v)

    def value(self):
        kind, v, _ = self.next()
        if kind == "num":
            return Num(v)
        if kind == "str":
            try:
                return Str(json.loads(v))
            except json.JSONDecodeError:
                return Str(v[1:-1])
        if kind == "dim":
            r, c = (int(x) for x in re.findall(r"\d+", v))
            lst = self.value()
            if not isinstance(lst, Lst) or len(lst.items) != r * c or not all(isinstance(x, Num) for x in lst.items):
                raise ParseError("matrix")
            return Mat(r, c, lst.items)
        if v == "(":
            items = [self.value()]
            while self.peek()[1] == ",":
                self.next()
                items.append(self.value())
            self.expect(")")
            return items[0] if len(items) == 1 else Tup(items)
        if v == "[":
            items = []
            if self.peek()[1] != "]":
                items.append(self.value())
                while self.peek()[1] == ",":
                    self.next()
                    items.append(self.value())
            self.expect("]")
            return Lst(items)
        raise ParseError(v)

    def top(self) -> tuple[list, str]:
        """Parse as many top-level values as possible; return them plus the
        unparsed remainder (raw text, possibly empty)."""
        vals = []
        while self.peek()[0] is not None:
            start = self.i
            try:
                vals.append(self.value())
            except (ParseError, IndexError, ValueError):
                self.i = start
                break
        return vals, self.text[self.peek()[2]:].strip() if self.peek()[0] is not None else ""


def fmt_num(x: float, sig: int = 4) -> str:
    """Rounded number for display; tiny values (|x| < 1e-12) are 0."""
    if math.isnan(x):
        return "NaN"
    if math.isinf(x):
        return "∞" if x > 0 else "−∞"
    if abs(x) < 1e-12:
        return "0"
    ax = abs(x)
    if 1e-4 <= ax < 1e6:
        s = f"{x:.{sig}g}"
        if "e" in s:  # e.g. 1.235e+05
            s = f"{x:.0f}"
    else:
        mant, exp = f"{x:.{sig - 1}e}".split("e")
        mant = mant.rstrip("0").rstrip(".")
        sup = str(int(exp)).translate(str.maketrans("-0123456789", "⁻⁰¹²³⁴⁵⁶⁷⁸⁹"))
        s = f"{mant}×10{sup}"
    return s.replace("-", "−")


def fmt_fixed(x: float, dec: int = 3) -> str:
    if abs(x) < 0.5 * 10 ** (-dec):
        x = 0.0
    return f"{x:.{dec}f}".replace("-", "−")


def is_num_tree(v) -> bool:
    return isinstance(v, Num) or (isinstance(v, Tup) and all(isinstance(x, Num) for x in v.items))


def shape(v):
    return "n" if isinstance(v, Num) else tuple(shape(x) for x in v.items)


def table_rows(vals: list) -> bool:
    """Lines like ("Name",(x,y),(z,w)) with a common shape -> a table."""
    if len(vals) < 2:
        return False
    if not all(isinstance(v, Tup) and isinstance(v.items[0], Str) and len(v.items) >= 2
               and all(is_num_tree(x) for x in v.items[1:]) for v in vals):
        return False
    return len({tuple(shape(x) for x in v.items[1:]) for v in vals}) == 1


