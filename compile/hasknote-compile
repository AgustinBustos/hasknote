    body, math = render_markdown(text)
    body = re.sub(r"<h([1-6])>", lambda m: f'<h{min(int(m.group(1)) + 1, 6)} class="sec">', body)
    body = re.sub(r"</h([1-6])>", lambda m: f"</h{min(int(m.group(1)) + 1, 6)}>", body)
    page = f"""<!doctype html><html><head><meta charset="utf-8">
<style>{print_font_css()}</style><style>{CSS_FILE.read_text(encoding="utf-8")}</style>
{katex_head("snippet") if math else ""}
</head><body class="mode-snippet"><main class="md snippet" style="width:{width}px">{body}</main>
<script>{SNIPPET_JS}</script></body></html>"""
    chrome = find_chromium()
    if not chrome:
        sys.exit("hasknote-compile: chromium not found on PATH")
    lines = text.count("\n") + 1
    height = max(240, min(12000, 120 + 46 * lines + 90 * text.count("$$")))
    with tempfile.TemporaryDirectory(prefix="hasknote-snip-") as tmp:
        src = Path(tmp) / "snippet.html"
        src.write_text(page, encoding="utf-8")
        shot = Path(tmp) / "shot.png"
        cmd = [chrome, "--headless=new", "--disable-gpu", "--no-first-run", "--no-default-browser-check",
               "--allow-file-access-from-files", f"--user-data-dir={tmp}/profile", "--hide-scrollbars",
               "--force-device-scale-factor=2", f"--window-size={width},{height}",
               "--default-background-color=ffffffff", "--virtual-time-budget=1500",
               f"--screenshot={shot}", src.as_uri()]
        subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        if not shot.exists():
            sys.exit("hasknote-compile: chromium could not render the snippet")
        im = Image.open(shot).convert("RGB")
    bbox = ImageChops.difference(im, Image.new("RGB", im.size, (255, 255, 255))).getbbox()
    p2 = pad * 2
    if bbox:
        x0, y0, x1, y1 = bbox
        im = im.crop((max(0, x0 - p2), max(0, y0 - p2), min(im.width, x1 + p2), min(im.height, y1 + p2)))
        # keep the full requested width so text size is stable across previews
        canvas = Image.new("RGB", (width * 2, im.height), (255, 255, 255))
        canvas.paste(im, (max(0, x0 - p2), 0))
        im = canvas
    else:
        im = Image.new("RGB", (width * 2, p2 * 2), (255, 255, 255))
    out_png.parent.mkdir(parents=True, exist_ok=True)
    im.save(out_png, optimize=False, compress_level=3)


# --------------------------------------------------------------------------


def main() -> None:
    ap = argparse.ArgumentParser(prog="hasknote-compile", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("notebook", type=Path, nargs="?", help="hasknote notebook (.hs)")
    ap.add_argument("-o", "--outdir", type=Path,
                    help="output directory (default: next to the notebook); with --md-snippet: the output PNG")
    ap.add_argument("--md-snippet", type=Path, metavar="IN.md",
                    help="render a markdown fragment to a tightly cropped PNG (needs -o OUT.png)")
    ap.add_argument("--width", type=int, default=760, help="--md-snippet: content width in CSS px (default 760)")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--html-only", action="store_true", help="only write the HTML")
    g.add_argument("--pdf-only", action="store_true", help="only write the .tex, its figures and the PDF")
    g.add_argument("--tex-only", action="store_true", help="only write the .tex and its figures (no pdflatex run)")
    ap.add_argument("--title", help="document title (default: `-- title:` comment, else the humanized file name)")
    ap.add_argument("--subtitle", default=None, help="subtitle line under the title")
    ap.add_argument("--short-title", default=None, help="running header of the PDF (default: shortened title)")
    ap.add_argument("--author", default=None, help="author (default: `-- author:` comment, else none)")
    ap.add_argument("--date", default=None, help="date line (default: today; '' to omit)")
    ap.add_argument("--hide-code", action="store_true", help="hide code cells (outputs and figures only)")
    ap.add_argument("--no-prose", action="store_true", help="keep leading -- comments as code instead of prose")
    ap.add_argument("--no-panels", action="store_true", help="one figure per chart instead of panel grids")
    ap.add_argument("--keep-plot-style", action="store_true",
                    help="keep each chart's own plotly template instead of the page's academic one")
    ap.add_argument("--inline-plotly", action="store_true",
                    help="embed plotly.js in the HTML (works offline, +3.5 MB)")
    ap.add_argument("--budget", type=int, default=20000, help="chromium virtual time budget in ms (default 20000)")
    a = ap.parse_args()

    if a.md_snippet:
        if not a.outdir:
            ap.error("--md-snippet needs -o OUT.png")
        out = a.outdir.expanduser().resolve()
        render_snippet(a.md_snippet.expanduser(), out, a.width)
        print(out)
        return
    if not a.notebook:
        ap.error("the notebook argument is required")
    nb = a.notebook.expanduser().resolve()
    if not nb.is_file():
        sys.exit(f"hasknote-compile: no such file: {a.notebook}")
    cells = parse_notebook(nb.read_text(encoding="utf-8", errors="replace"))
    meta = take_directives(cells)
    a.title = a.title or meta.get("title") or humanize(nb.stem)
    a.subtitle = a.subtitle if a.subtitle is not None else meta.get("subtitle", "")
    a.author = a.author if a.author is not None else meta.get("author", "")
    if a.date is None:
        d = dt.date.today()
        a.date = meta.get("date") or f"{d.day} {d.strftime('%B %Y')}"
    outdir = a.outdir.expanduser().resolve() if a.outdir else nb.parent
    outdir.mkdir(parents=True, exist_ok=True)

    r = Renderer(a, nb)
    if not (a.pdf_only or a.tex_only):
        out = outdir / f"{nb.stem}.html"
        out.write_text(r.page(cells, "html"), encoding="utf-8")
        print(f"wrote {out}  ({r.fig_no} figures, {len(r.charts)} charts, {r.tab_no} tables)")
    if not a.html_only:
        figdir = outdir / f"{nb.stem}-figures"
        t = TexRenderer(a, nb, figdir)
        tex = t.document(cells)
        tex_path = outdir / f"{nb.stem}.tex"
        tex_path.write_text(tex.replace("pdflatex urep.tex", f"pdflatex {nb.stem}.tex"), encoding="utf-8")
        export_charts(t.charts, figdir, a.budget)
        print(f"wrote {tex_path}  (+ {len(t.charts)} vector figures in {figdir.name}/)")
        r.missing += t.missing
        if not a.tex_only:
            pdf = outdir / f"{nb.stem}.pdf"
            compile_tex(tex_path, pdf)
            print(f"wrote {pdf}")
    for m in dict.fromkeys(r.missing):
        print(f"warning: chart not found: {m}", file=sys.stderr)


if __name__ == "__main__":
    main()
