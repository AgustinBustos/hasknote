# Rendering helpers


def _css_class(ttype) -> str:
    while ttype not in STANDARD_TYPES:
        ttype = ttype.parent
    return STANDARD_TYPES[ttype]


def highlight_lines(src: str, lexer) -> str:
    """Pygments tokens -> one <span class="ln"> per source line; lines that may wrap
    get a hanging indent past their own indentation."""
    lines: list[list[str]] = [[]]
    for ttype, value in lexer.get_tokens(src):
        cls = _css_class(ttype)
        for k, piece in enumerate(value.split("\n")):
            if k:
                lines.append([])
            if piece:
                e = html.escape(piece, quote=False)
                lines[-1].append(f'<span class="{cls}">{e}</span>' if cls else e)
    while lines and not lines[-1]:
        lines.pop()
    raw = src.split("\n")
    out = []
    for k, l in enumerate(lines):
        text = raw[k] if k < len(raw) else ""
        style = ""
        if len(text) > 50:
            hang = len(text) - len(text.lstrip(" ")) + 4
            style = f' style="padding-left:{hang}ch;text-indent:-{hang}ch"'
        out.append(f'<span class="ln"{style}>{"".join(l) or " "}</span>')
    return "".join(out)


def humanize(stem: str) -> str:
    words = re.sub(r"([a-z])([A-Z])", r"\1 \2", stem).replace("_", " ").replace("-", " ").split()
    return " ".join(w if w[:1].isupper() else w[:1].upper() + w[1:] for w in words) or stem


def _cap(s: str, period: bool = True) -> str:
    s = s.strip()
    if not s:
        return ""
    s = s[0].upper() + s[1:]
    return s if (not period or s[-1] in ".?!:") else s + "."


def short_title(t: str) -> str:
    if len(t) <= 48:
        return t
    for sep in (":", " — ", " - ", "("):
        if sep in t and 3 < t.index(sep) <= 48:
            return t[: t.index(sep)].strip()
    return t[:45].rsplit(" ", 1)[0] + "…"


_MD = None


def render_markdown(text: str) -> tuple[str, bool]:
    """CommonMark (+ tables, strikethrough) with $...$ / $$...$$ math left for KaTeX."""
    global _MD
    if _MD is None:
        from markdown_it import MarkdownIt
        from mdit_py_plugins.dollarmath import dollarmath_plugin
        _MD = (MarkdownIt("commonmark", {"typographer": True})
               .enable(["table", "strikethrough", "replacements", "smartquotes"])
               .use(dollarmath_plugin, allow_space=True, allow_digits=False, double_inline=True))
    h = _MD.render(text)
    h = h.replace("<table>", '<table class="booktabs md-table">')
    return h, 'class="math' in h


class Renderer:
    def __init__(self, args, nb_path: Path):
        self.args = args
        self.nb_path = nb_path
        self.nb_dir = nb_path.parent
        self.lexer = HaskellLexer(stripnl=False)
        self.reset()

    def reset(self):
        self.fig_no = 0
        self.tab_no = 0
        self.charts: list[dict] = []
        self.uses_vega = False
        self.uses_katex = False
        self.missing: list[str] = []

    # -- inline text -------------------------------------------------------
    def inline(self, s: str) -> str:
        """Tiny markdown subset for prose: `code`, **bold**, *italic*, $math$."""
        parts = re.split(r"(`[^`]+`|\$\$[^$]+\$\$|\$[^$\n]+\$)", s)
        out = []
        for p in parts:
            if p.startswith("`") and p.endswith("`") and len(p) > 1:
                out.append(f"<code>{html.escape(p[1:-1])}</code>")
            elif p.startswith("$$") and p.endswith("$$") and len(p) > 4:
                self.uses_katex = True
                out.append(f'<span class="math display">{html.escape(p[2:-2])}</span>')
            elif p.startswith("$") and p.endswith("$") and len(p) > 2:
                self.uses_katex = True
                out.append(f'<span class="math inline">{html.escape(p[1:-1])}</span>')
            else:
                e = html.escape(p)
                e = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", e)
                e = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"<em>\1</em>", e)
                out.append(e)
        return "".join(out)

    def prose(self, lines: list[str]) -> str:
        """Short label-like comments ("uhlig algorithm") become run-in headings;
        longer comments become paragraphs."""
        paras, cur = [], []
        for ln in lines + [""]:
            if ln:
                cur.append(ln)
            elif cur:
                paras.append(cur)
                cur = []
        out = []

        def label(t: str) -> bool:
            return len(t) <= 48 and not re.search(r"[.!?;:,]$", t)

        for p in paras:
            if label(p[0]) and (len(p) == 1 or len(p[1]) > len(p[0])):
                out.append(f'<p class="runin">{self.inline(_cap(p[0], period=False))}</p>')
                p = p[1:]
            if p and len(p) <= 4 and all(label(x) for x in p):
                joined = '<span class="dot"> · </span>'.join(self.inline(_cap(x, period=False)) for x in p)
                out.append(f'<p class="runin">{joined}</p>')
            elif p:
                text = " ".join(p)
                out.append(f'<p class="prose">{self.inline(_cap(text, period=False))}</p>')
        return "".join(out)

    # -- code ----------------------------------------------------------------
    def code_block(self, lines: list[str], n: int) -> str:
        hl = highlight_lines("\n".join(lines), self.lexer)
        long = " long" if len(lines) > LONG_CODE_LINES else ""
        return (f'<div class="code{long}"><span class="label">In [{n}]</span>'
                f'<pre class="hl">{hl}</pre></div>')

    def setup_block(self, lines: list[str], n: int, mode: str) -> str:
        count = len([l for l in lines if l.strip()])
        mods = [m for l in lines for m in re.findall(r"^\s*import\s+(?:qualified\s+)?([\w.]+)", l)]
        listing = ", ".join(mods[:6]) + (", …" if len(mods) > 6 else "")
        if mode == "print":
            return (f'<p class="setup-note"><span class="sc">Setup.</span> {count} lines of GHCi options and '
                    f'imports{": " + html.escape(listing) if listing else ""} (omitted).</p>')
        return (f'<details class="setup"><summary><span class="sc">Setup</span>'
                f'<span class="setup-meta"> — {count} lines'
                f'{" · " + html.escape(listing) if listing else ""}</span></summary>'
                f'{self.code_block(lines, n)}</details>')

    # -- outputs -------------------------------------------------------------
    def num_html(self, n: Num, sig: int = 4) -> str:
        return f'<span class="num" title="{html.escape(n.raw)}">{fmt_num(n.value, sig)}</span>'

    def matrix_html(self, rows: list[list[Num]], label: str = "") -> str:
        body = "".join("<tr>" + "".join(f"<td>{self.num_html(x)}</td>" for x in r) + "</tr>" for r in rows)
        lab = f'<span class="dim">{label}</span>' if label else ""
        return f'<span class="mat-wrap"><span class="mat"><table>{body}</table></span>{lab}</span>'

    def value_html(self, v, top: bool = False) -> str:
        if isinstance(v, Num):
            return self.num_html(v, 6 if top else 4)
        if isinstance(v, Str):
            return f'<span class="str">“{html.escape(v.text)}”</span>'
        if isinstance(v, Mat):
            rows = [v.data[i * v.cols:(i + 1) * v.cols] for i in range(v.rows)]
            return self.matrix_html(rows, f"{v.rows}×{v.cols}" if v.rows * v.cols > 1 else "")
        if isinstance(v, Lst):
            if v.items and all(isinstance(x, Num) for x in v.items):
                cells = "".join(self.num_html(x) for x in v.items)
                return (f'<span class="mat-wrap"><span class="mat vec">{cells}</span>'
                        f'<span class="dim">list of {len(v.items)}</span></span>')
            inner = '<span class="sep">, </span>'.join(self.value_html(x) for x in v.items)
            return f'<span class="lst"><span class="br">[</span>{inner}<span class="br">]</span></span>'
        if isinstance(v, Tup):
            if all(isinstance(x, (Num, Str)) for x in v.items):
                inner = ", ".join(self.value_html(x) for x in v.items)
                return f'<span class="tup-inline">({inner})</span>'
            inner = '<span class="sep">,</span>'.join(f'<span class="item">{self.value_html(x)}</span>' for x in v.items)
            return f'<span class="tup"><span class="paren">(</span>{inner}<span class="paren">)</span></span>'
        return html.escape(str(v))

    def table_html(self, vals: list[Tup], caption: str) -> str:
        self.tab_no += 1
        groups = [x for x in vals[0].items[1:]]
        head_top, head_sub, rules = ['<th class="stub"></th>'], ['<th class="stub"></th>'], []
        col = 2
        nested = any(isinstance(g, Tup) for g in groups)
        for gi, g in enumerate(groups, 1):
            width = len(g.items) if isinstance(g, Tup) else 1
            head_top.append(f'<th colspan="{width}" class="grp">({gi})</th>')
            for k in range(width):
                head_sub.append(f'<th class="sub">{"abcdefgh"[k] if width > 1 else ""}</th>')
            if width > 1:
                rules.append((col, col + width - 1))
            col += width
        rows = []
        for v in vals:
            cells = [f'<th scope="row">{html.escape(v.items[0].text)}</th>']
            for g in v.items[1:]:
                for x in (g.items if isinstance(g, Tup) else [g]):
                    cells.append(f'<td title="{html.escape(x.raw)}">{fmt_fixed(x.value)}</td>')
            rows.append("<tr>" + "".join(cells) + "</tr>")
        thead = "<tr>" + "".join(head_top) + "</tr>"
        if nested:
            thead += "<tr>" + "".join(head_sub) + "</tr>"
        cap = f" {self.inline(_cap(caption))}" if caption else ""
        return (f'<figure class="tbl" id="tab-{self.tab_no}"><figcaption><span class="fignum">Table {self.tab_no}.</span>{cap}</figcaption>'
                f'<table class="booktabs{" nested" if nested else ""}"><thead>{thead}</thead><tbody>{"".join(rows)}</tbody></table></figure>')

    def output_html(self, text: str, n: int, caption: str) -> str:
        vals, rest = ValueParser(text).top()
        raw = f'<pre class="raw">{html.escape(text)}</pre>'
        label = f'<span class="label">Out [{n}]</span>'
        if not vals:
            return f'<div class="out">{label}{raw}</div>'
        parts, i = [], 0
        while i < len(vals):  # group consecutive table rows
            j = i
            while j < len(vals) and isinstance(vals[j], Tup) and vals[j].items and isinstance(vals[j].items[0], Str):
                j += 1
            if j - i >= 2 and table_rows(vals[i:j]):
                parts.append(("table", vals[i:j]))
                i = j
            else:
                parts.append(("val", vals[i]))
                i += 1
        if len(parts) == 1 and parts[0][0] == "table" and not rest:
            return self.table_html(parts[0][1], caption) + f'<details class="rawbox"><summary>raw output</summary>{raw}</details>'
        pretty = []
        for kind, p in parts:
            if kind == "table":
                pretty.append(self.table_html(p, caption))
            else:
                pretty.append(f'<div class="val">{self.value_html(p, top=True)}</div>')
        if rest:
            pretty.append(f'<pre class="rest">{html.escape(rest)}</pre>')
        scal = all(k == "val" and isinstance(p, Num) for k, p in parts)
        cls = "pretty scalars" if scal and len(parts) > 1 else "pretty"
        return (f'<div class="out has-pretty">{label}<button class="rawtoggle" type="button" title="show the raw GHCi output">raw</button>'
                f'<div class="{cls}">{"".join(pretty)}</div>{raw}</div>')

    # -- figures -------------------------------------------------------------
    def chart_div(self, spec: dict, panel: bool) -> str:
        if spec["type"] == "missing":
            self.missing.append(spec["path"])
            return (f'<div class="chart-missing">Chart not available'
                    f'<span class="path">{html.escape(spec["path"])}</span></div>')
        cid = f"chart-{len(self.charts) + 1}"
        if spec["type"] == "plotly":
            payload = {"id": cid, "type": "plotly", "panel": panel,
                       **prepare_plotly(spec, panel, self.args.keep_plot_style)}
        elif spec["type"] == "vega":
            self.uses_vega = True
            vs = copy.deepcopy(spec["spec"])
            vs.pop("title", None)
            payload = {"id": cid, "type": "vega", "panel": panel, "spec": vs}
        else:
            doc = html.escape(spec["html"], quote=True)
            return f'<iframe class="chart-frame" sandbox="allow-scripts" srcdoc="{doc}"></iframe>'
        self.charts.append(payload)
        return f'<div class="chart{" panel-chart" if panel else ""}" id="{cid}"></div>'

    def figure(self, specs: list[dict], fallback_caption: str) -> str:
        self.fig_no += 1
        n = self.fig_no
        titles = [chart_title(s) for s in specs]
        if len(specs) == 1:
            cap = titles[0] or fallback_caption or series_label(specs[0])
            sub = series_label(specs[0]) if (titles[0] or fallback_caption) else ""
            cap_html = self.inline(_cap(cap)) + (f' <span class="sub">{html.escape(_cap(sub))}</span>' if sub and sub != cap else "")
            return (f'<figure class="fig single" id="fig-{n}">{self.chart_div(specs[0], panel=False)}'
                    f'<figcaption><span class="fignum">Figure {n}.</span> {cap_html}</figcaption></figure>')
        common = titles[0] if titles[0] and len(set(titles)) == 1 else ""
        cap = common or fallback_caption
        panels = []
        for k, s in enumerate(specs):
            letter = "abcdefghijklmnopqrstuvwxyz"[k % 26]
            sub = (titles[k] if titles[k] and not common else "") or series_label(s)
            panels.append(f'<div class="panel">{self.chart_div(s, panel=True)}'
                          f'<div class="subcap"><span class="letter">({letter})</span> {html.escape(sub)}</div></div>')
        cap_html = self.inline(_cap(cap)) if cap else ""
        return (f'<figure class="fig panels" id="fig-{n}"><div class="grid">{"".join(panels)}</div>'
                f'<figcaption><span class="fignum">Figure {n}.</span> {cap_html}</figcaption></figure>')

    # -- document ------------------------------------------------------------
    def render_cells(self, cells: list[Cell], mode: str) -> tuple[str, str]:
        body, toc = [], []
        counters = [0] * 7
        n_cell = 0
        first_content = True
        def section(level: int, title_html: str) -> str:
            lvl = min(level, 3)
            counters[lvl] += 1
            for j in range(lvl + 1, len(counters)):
                counters[j] = 0
            num = ".".join(str(c) for c in counters[1:lvl + 1])
            sid = f"sec-{num.replace('.', '-')}"
            tag = f"h{lvl + 1}"
            toc.append(f'<li class="toc-{lvl}"><a href="#{sid}"><span class="secnum">{num}</span>'
                       f"{title_html}</a></li>")
            return f'<{tag} id="{sid}" class="sec"><span class="secnum">{num}</span>{title_html}</{tag}>'

        for cell in cells:
            if cell.kind == "md":
                text = "\n".join(cell.md).strip()
                if not text:
                    continue
                h, math = render_markdown(text)
                self.uses_katex |= math
                h = re.sub(r"<h([1-6])>(.*?)</h\1>", lambda m: section(int(m.group(1)), m.group(2)), h, flags=re.S)
                body.append(f'<section class="cell md">{h}</section>')
                continue
            if cell.level and cell.title:
                body.append(section(cell.level, self.inline(cell.title)))
            if self.args.no_prose:
                prose, code = [], tidy_lines(cell.code)
            else:
                prose, code = split_prose(cell.code)
            segs = split_output(cell.output)
            if not (prose or code or segs):
                continue
            n_cell += 1
            setup = is_setup(code) and not prose and not any(isinstance(s, Chart) for s in segs)
            if setup:
                body.append(f'<section class="cell setup-cell">{self.setup_block(code, n_cell, mode)}</section>')
                first_content = False
                continue
            first_content = False
            parts = []
            if prose:
                parts.append(self.prose(prose))
            if code:
                parts.append(self.code_block(code, n_cell))
            first_prose = next((p for p in prose if p), "")
            group: list[dict] = []

            def flush_group():
                if not group:
                    return
                size = 1 if self.args.no_panels else 6
                for k in range(0, len(group), size):
                    parts.append(self.figure(group[k:k + size], first_prose))
                group.clear()

            for seg in segs:
                if isinstance(seg, Chart):
                    group.append(load_chart(seg, self.nb_dir))
                else:
                    flush_group()
                    parts.append(self.output_html(seg, n_cell, first_prose))
            flush_group()
            body.append(f'<section class="cell">{"".join(parts)}</section>')
        toc_html = ""
        if len(toc) >= 2:
            toc_html = ('<nav class="toc"><div class="toc-title">Contents</div><ol>'
                        + "".join(toc) + "</ol></nav>")
        return "".join(body), toc_html

    def page(self, cells: list[Cell], mode: str) -> str:
        """mode: "html" (interactive) or "print" (for the PDF)."""
        self.reset()
        body, toc = self.render_cells(cells, mode)
        a = self.args
        css = CSS_FILE.read_text(encoding="utf-8")
        if mode == "print":
            fonts = print_font_css()
        else:
            fonts = font_css()
        head_fonts = f"<style>{fonts}</style>"
        scripts = []
        if any(c["type"] == "plotly" for c in self.charts):
            local = cached_asset(PLOTLY_CDN, f"plotly-{PLOTLY_VERSION}.min.js") if (mode == "print" or a.inline_plotly) else None
            if local and a.inline_plotly and mode == "html":
                scripts.append(f"<script>{local.read_text(encoding='utf-8')}</script>")
            elif local and mode == "print":
                scripts.append(f'<script src="{local.as_uri()}"></script>')
            else:
                scripts.append(f'<script src="{PLOTLY_CDN}" charset="utf-8"></script>')
        if self.uses_vega:
            scripts += [f'<script src="{u}"></script>' for u in VEGA_CDN]
        katex = katex_head(mode) if self.uses_katex else ""
        title = html.escape(a.title)
        meta = []
        if a.subtitle:
            meta.append(f'<p class="subtitle">{self.inline(a.subtitle)}</p>')
        byline = [f'<span class="author">{html.escape(a.author)}</span>'] if a.author else []
        if a.date:
            byline.append(f'<span class="date">{html.escape(a.date)}</span>')
        if byline:
            meta.append('<p class="byline">' + '<span class="dot"> · </span>'.join(byline) + "</p>")
        eyebrow = f'<p class="eyebrow">Notebook <span class="dot">·</span> <span class="file">{html.escape(self.nb_path.name)}</span></p>'
        tools = ("" if mode == "print" else
                 '<div class="tools"><button id="toggle-code" type="button">Hide code</button></div>')
        running = short_title(a.short_title or a.title).replace("\\", "\\\\").replace('"', '\\"')
        page_css = f'@page {{ @top-center {{ content: "{running}"; }} }} @page :first {{ @top-center {{ content: none; }} }}'
        charts_json = json.dumps(self.charts, separators=(",", ":")).replace("</", "<\\/")
        cls = " ".join(c for c in [f"mode-{mode}", "hide-code" if a.hide_code else ""] if c)
        return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="generator" content="hasknote-compile">
{head_fonts}
<style>{css}
{page_css}</style>
{katex}
{"".join(scripts)}
</head>
<body class="{cls}">
<main class="paper">
<header class="titleblock">{eyebrow}<h1 class="title">{title}</h1>{"".join(meta)}</header>
{tools}
{toc}
{body}
<footer class="colophon">Compiled from <span class="file">{html.escape(self.nb_path.name)}</span> with hasknote · {self.fig_no} figures{f", {self.tab_no} tables" if self.tab_no else ""}</footer>
</main>
<script>window.HASKNOTE = {{mode: {json.dumps(mode)}, printWidth: {PRINT_TEXT_WIDTH_PX}, charts: {charts_json}}};</script>
<script>{PAGE_JS}</script>
</body></html>
"""


PAGE_JS = r"""
(function () {
  const H = window.HASKNOTE, isPrint = H.mode === "print";
  window.HASKNOTE_DONE = false;
  const btn = document.getElementById("toggle-code");
  if (btn) {
