# --------------------------------------------------------------------------
# Assets (cached under ~/.cache/hasknote/compile)

UA_WOFF2 = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"


def _fetch(url: str, timeout: float = 20, ua: str | None = UA_WOFF2) -> bytes:
    req = urllib.request.Request(url, headers={"User-Agent": ua} if ua else {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def cached_asset(url: str, name: str) -> Path | None:
    p = CACHE / name
    if p.exists() and p.stat().st_size > 0:
        return p
    try:
        data = _fetch(url, timeout=60)
    except Exception as e:  # offline
        print(f"hasknote-compile: could not download {url}: {e}", file=sys.stderr)
        return None
    CACHE.mkdir(parents=True, exist_ok=True)
    p.write_bytes(data)
    return p


def _latin_modern_dir() -> Path | None:
    """Latin Modern OTFs, extracted once from the GUST zip (or CTAN) into the cache."""
    d = CACHE / "lm"
    names = {f for _, _, _, f in LM_FACES}
    if all((d / n).exists() for n in names):
        return d
    d.mkdir(parents=True, exist_ok=True)
    try:
        import io
        import zipfile
        z = zipfile.ZipFile(io.BytesIO(_fetch(LM_ZIP, timeout=90)))
        for member in z.namelist():
            base = member.rsplit("/", 1)[-1]
            if base in names:
                (d / base).write_bytes(z.read(member))
    except Exception as e:
        print(f"hasknote-compile: GUST download failed ({e}); trying CTAN", file=sys.stderr)
    for n in names:
        if not (d / n).exists():
            try:
                (d / n).write_bytes(_fetch(LM_FALLBACK.format(name=n), timeout=60))
            except Exception as e:
                print(f"hasknote-compile: could not get {n}: {e}", file=sys.stderr)
    return d if any((d / n).exists() for n in names) else None


def otf_to_ttf(src: Path, dst: Path) -> None:
    """Convert a CFF-flavoured OpenType font to TrueType outlines (cubic -> quadratic).
    Chromium/Skia embeds CFF fonts in PDFs as Type 3 (badly rendered by zathura,
    evince, pdf.js); TrueType fonts are embedded as real CID TrueType fonts."""
    from fontTools.pens.cu2quPen import Cu2QuPen
    from fontTools.pens.ttGlyphPen import TTGlyphPen
    from fontTools.ttLib import TTFont, newTable

    font = TTFont(str(src))
    order = font.getGlyphOrder()
    gs = font.getGlyphSet()
    quad = {}
    for name in order:
        pen = TTGlyphPen(gs)
        gs[name].draw(Cu2QuPen(pen, 1.0, reverse_direction=True))
        quad[name] = pen.glyph()
    font["loca"] = newTable("loca")
    font["glyf"] = glyf = newTable("glyf")
    glyf.glyphOrder = order
    glyf.glyphs = quad
    del font["CFF "]
    if "VORG" in font:
        del font["VORG"]
    glyf.compile(font)
    hmtx = font["hmtx"]
    for name, g in glyf.glyphs.items():
        if hasattr(g, "xMin"):
            hmtx[name] = (hmtx[name][0], g.xMin)
    maxp = font["maxp"] = newTable("maxp")
    maxp.tableVersion = 0x00010000
    for attr in ("maxZones", "maxTwilightPoints", "maxStorage", "maxFunctionDefs", "maxInstructionDefs",
                 "maxStackElements", "maxSizeOfInstructions", "maxComponentElements"):
        setattr(maxp, attr, 1 if attr == "maxZones" else 0)
    maxp.compile(font)
    post = font["post"]
    post.formatType = 2.0
    post.extraNames = []
    post.mapping = {}
    post.glyphOrder = order
    font.sfntVersion = "\0\1\0\0"
    font.save(str(dst))


def _lm_ttf(otf: Path) -> Path:
    d = CACHE / "lm-ttf"
    d.mkdir(parents=True, exist_ok=True)
    t = d / (otf.stem + ".ttf")
    if not t.exists():
        otf_to_ttf(otf, t)
    return t


def _code_font_file(patterns: list[str]) -> Path | None:
    for pat in patterns:
        try:
            r = subprocess.run(["fc-match", pat, "--format=%{family}\t%{file}"], capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            return None
        fam, _, f = r.stdout.partition("\t")
        want = pat.split(":")[0].replace(" ", "").lower()
        if f and want in fam.replace(" ", "").lower():
            return Path(f)
    return None


def font_faces() -> list[tuple[str, int, str, Path]]:
    faces = []
    lm = _latin_modern_dir()
    if lm:
        for fam, w, st, f in LM_FACES:
            if (lm / f).exists():
                try:
                    faces.append((fam, w, st, _lm_ttf(lm / f)))
                except Exception as e:  # keep the OTF (embedded as Type 3 in PDFs)
                    print(f"hasknote-compile: TrueType conversion of {f} failed: {e}", file=sys.stderr)
                    faces.append((fam, w, st, lm / f))
    for fam, w, st, pats in CODE_FACES:
        f = _code_font_file(pats)
        if f:
            faces.append((fam, w, st, f))
    return faces


def _face_rule(fam: str, w: int, st: str, src: str, fmt: str) -> str:
    return (f"@font-face{{font-family:'{fam}';font-weight:{w};font-style:{st};font-display:block;"
            f"src:url({src}) format('{fmt}');}}")


def print_font_css() -> str:
    """PDF / snippets: the full font files via file:// URLs. All are static OpenType
    (CFF) or TrueType fonts, which Chromium embeds as real fonts (no Type 3)."""
    fmt = {".otf": "opentype", ".ttf": "truetype"}
    return "\n".join(_face_rule(fam, w, st, f.as_uri(), fmt.get(f.suffix.lower(), "opentype"))
                     for fam, w, st, f in font_faces())


_FONT_CSS: str | None = None


def font_css() -> str:
    """HTML: subset WOFF2 copies of the same fonts embedded as base64, so the page is
    self-contained and looks the same on any machine (cached per font file)."""
    global _FONT_CSS
    if _FONT_CSS is not None:
        return _FONT_CSS
    from fontTools import subset
    out = []
    sub_dir = CACHE / "woff2"
    sub_dir.mkdir(parents=True, exist_ok=True)
    for fam, w, st, f in font_faces():
        key = hashlib.sha1(f"{f}:{f.stat().st_size}:{SUBSET_UNICODES}".encode()).hexdigest()[:16]
        target = sub_dir / f"{key}.woff2"
        if not target.exists():
            try:
                opts = subset.Options()
                opts.flavor = "woff2"
                opts.layout_features = ["*"]  # keep ligatures, small caps, figures
                opts.name_IDs = ["*"]
                opts.notdef_outline = True
                font = subset.load_font(str(f), opts)
                ss = subset.Subsetter(opts)
                ss.populate(unicodes=subset.parse_unicodes(SUBSET_UNICODES))
                ss.subset(font)
                subset.save_font(font, str(target), opts)
            except Exception as e:
                print(f"hasknote-compile: could not subset {f.name}: {e}", file=sys.stderr)
                continue
        b64 = base64.b64encode(target.read_bytes()).decode()
        out.append(_face_rule(fam, w, st, f"data:font/woff2;base64,{b64}", "woff2"))
    _FONT_CSS = "\n".join(out)
    return _FONT_CSS


def katex_dir() -> Path | None:
    """KaTeX dist (js, css, fonts), downloaded once from the npm registry."""
    d = CACHE / f"katex-{KATEX_VERSION}"
    if (d / "katex.min.js").exists():
        return d
    try:
        import io
        import tarfile
        tf = tarfile.open(fileobj=io.BytesIO(_fetch(KATEX_TGZ, timeout=90)), mode="r:gz")
        d.mkdir(parents=True, exist_ok=True)
        for m in tf.getmembers():
            if not m.isfile() or not m.name.startswith("package/dist/"):
                continue
            rel = m.name[len("package/dist/"):]
            if rel.startswith("contrib/") or rel.endswith((".min.js", ".min.css")) or (rel.startswith("fonts/") and rel.endswith(".woff2")):
                t = d / rel
                t.parent.mkdir(parents=True, exist_ok=True)
                t.write_bytes(tf.extractfile(m).read())
        return d
    except Exception as e:
        print(f"hasknote-compile: KaTeX unavailable ({e}); math stays as TeX source", file=sys.stderr)
        return None


def katex_head(mode: str) -> str:
    """<head> snippet for KaTeX: inlined (fonts as base64) for the self-contained HTML,
    file:// links for the PDF and snippet renderer."""
    d = katex_dir()
    if not d:
        return ""
    if mode != "html":
        return (f'<link rel="stylesheet" href="{(d / "katex.min.css").as_uri()}">'
                f'<script src="{(d / "katex.min.js").as_uri()}"></script>')
    css = (d / "katex.min.css").read_text(encoding="utf-8")

    def embed(m):
        f = d / m.group(1)
        if f.suffix == ".woff2" and f.exists():
            return f"url(data:font/woff2;base64,{base64.b64encode(f.read_bytes()).decode()}) format(\"woff2\")"
        return ""
    css = re.sub(r"url\((fonts/[^)]+\.woff2)\)\s*format\([\"']woff2[\"']\)", embed, css)
    css = re.sub(r",?\s*url\(fonts/[^)]+\.(?:woff|ttf)\)\s*format\([\"'](?:woff|truetype)[\"']\)", "", css)
    js = (d / "katex.min.js").read_text(encoding="utf-8").replace("</script", "<\\/script")
    return f"<style>{css}</style><script>{js}</script>"


