def _fontconfig_file() -> Path:
    """A fontconfig file that adds the cached Latin Modern TTFs, so rsvg-convert renders
    chart text in the same LaTeX serif (nothing is installed system-wide)."""
    font_faces()  # make sure the TTFs exist
    conf = CACHE / "fonts.conf"
