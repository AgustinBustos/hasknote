      if (c.type === "plotly" && el && el.data) Plotly.relayout(el, Object.assign({autosize: false}, dims(c, true)));
    }));
    window.addEventListener("afterprint", () => H.charts.forEach(c => {
      const el = document.getElementById(c.id);
      if (c.type === "plotly" && el && el.data) Plotly.relayout(el, {autosize: true, width: null, height: null});
    }));
  }
})();
"""


