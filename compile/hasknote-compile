def academic_template(font_size: int) -> dict:
    axis = {
        "automargin": True, "showline": True, "linecolor": "#222", "linewidth": 0.8,
        "mirror": True, "ticks": "outside", "tickcolor": "#222", "ticklen": 4,
        "tickwidth": 0.8, "showgrid": True, "gridcolor": "#eceef2", "gridwidth": 0.6,
        "zeroline": True, "zerolinecolor": "#aeb4bf", "zerolinewidth": 0.8,
        "title": {"standoff": 6},
    }
    return {
        "data": {"scatter": [{"line": {"width": 1.5}}]},
        "layout": {
            "font": {"family": BODY_FONT, "size": font_size, "color": "#1a1a1a"},
            "paper_bgcolor": "#ffffff", "plot_bgcolor": "#ffffff",
            "xaxis": axis, "yaxis": copy.deepcopy(axis),
            "legend": {"bgcolor": "rgba(255,255,255,0.85)", "bordercolor": "#d0d5dd", "borderwidth": 0},
            "colorway": ["#332288", "#CC6677", "#44AA99", "#DDCC77", "#882255",
                         "#88CCEE", "#117733", "#999933", "#AA4499"],
            "hoverlabel": {"font": {"family": BODY_FONT}},
        },
    }


def load_chart(ch: Chart, nb_dir: Path) -> dict:
    """Returns {"type": "plotly"|"vega"|"iframe"|"missing", ...}."""
    p = Path(ch.path).expanduser()
    if not p.is_absolute():
        p = nb_dir / p
    try:
        src = p.read_text(encoding="utf-8")
    except OSError:
        return {"type": "missing", "path": ch.path}
    if ch.kind == "plot" or p.suffix == ".json":
        try:
            return {"type": "vega", "spec": json.loads(src)}
        except json.JSONDecodeError:
            return {"type": "missing", "path": ch.path}
    m = re.search(r"Plotly\.(?:newPlot|react)\(\s*(?:\"[^\"]*\"|'[^']*'|[\w.$]+)\s*,\s*", src)
    if m:
        dec = json.JSONDecoder()
        try:
            traces, end = dec.raw_decode(src, m.end())
            rest = src[end:]
            m2 = re.match(r"\s*,\s*", rest)
            layout = dec.raw_decode(rest, m2.end())[0] if m2 else {}
            if isinstance(traces, list) and isinstance(layout, dict):
                return {"type": "plotly", "traces": traces, "layout": layout}
        except (json.JSONDecodeError, ValueError):
            pass
    return {"type": "iframe", "html": src}


def chart_title(spec: dict) -> str:
    if spec["type"] == "plotly":
        t = spec["layout"].get("title")
        t = t.get("text", "") if isinstance(t, dict) else (t or "")
        return re.sub(r"<[^>]+>", "", str(t)).strip()
    if spec["type"] == "vega":
        t = spec["spec"].get("title", "")
        return (t.get("text", "") if isinstance(t, dict) else str(t)).strip()
    return ""


def series_label(spec: dict) -> str:
    if spec["type"] != "plotly":
        return ""
    names = list(dict.fromkeys(str(t.get("name")) for t in spec["traces"] if t.get("name")))
    if not names:
        return ""
    label = names[0] if len(names) == 1 else ", ".join(names[:-1]) + " and " + names[-1]
    xt = spec["layout"].get("xaxis", {}).get("title", {})
    xt = xt.get("text", "") if isinstance(xt, dict) else str(xt or "")
    return f"{label} against {xt}" if xt else label


def prepare_plotly(spec: dict, panel: bool, keep_style: bool) -> dict:
    lay = copy.deepcopy(spec["layout"])
    for k in ("title", "width", "height"):
        lay.pop(k, None)
    if not keep_style:
        lay["template"] = academic_template(12 if panel else 13)
        lay.pop("font", None)
    multi = sum(1 for t in spec["traces"] if t.get("showlegend", True) is not False) > 1
    lay["margin"] = {"l": 6, "r": 8, "t": 30 if multi else 10, "b": 6, "pad": 0}
    if multi and "x" not in (spec["layout"].get("legend") or {}):
        lay["legend"] = {"orientation": "h", "x": 0, "xanchor": "left", "y": 1.0, "yanchor": "bottom",
                         "borderwidth": 0, "bgcolor": "rgba(0,0,0,0)", "itemwidth": 30}
    yt = lay.get("yaxis", {}).get("title")
    if isinstance(yt, dict) and yt.get("text") == "value":
        yt["text"] = ""
    return {"traces": spec["traces"], "layout": lay}


